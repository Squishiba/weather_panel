{
    "search.exclude": {
        "**/build": true,
        "**/_deps": true,
        "**/CMakeFiles": true,
        "**/*.ninja*": true,
        "**/.ninja_*": true,
        "pimoroni-pico/.git": true,
        "inc/third_party/**/test": true,
        "inc/third_party/**/tests": true,
        "inc/third_party/**/example": true,
        "inc/third_party/**/examples": true,
        "inc/third_party/**/doc": true,
        "inc/third_party/**/docs": true,
        "weather.dis": true,
        "weather.elf.map": true,
        "weather.hex": true
    },
    "files.watcherExclude": {
        "**/build/**": true,
        "**/_deps/**": true,
        "**/CMakeFiles/**": true,
        "pimoroni-pico/.git/**": true,
        "inc/third_party/**": true
    },
    "C_Cpp.files.exclude": {
        "**/build": true,
        "**/_deps/cmsisdsp-src/Examples": true,
        "**/_deps/cmsisdsp-src/Testing": true,
        "**/CMakeFiles": true,
        "pimoroni-pico/.git": true,
        "pimoroni-pico/micropython": true,
        "pimoroni-pico/examples": true,
        "inc/third_party/**/test": true,
        "inc/third_party/**/tests": true,
        "inc/third_party/**/example": true,
        "inc/third_party/**/examples": true,
        "inc/third_party/etl-src/temp": true,
        "inc/third_party/etl-src/support": true
    },
    "cmake.showSystemKits": false,
    "cmake.options.statusBarVisibility": "hidden",
    "cmake.options.advanced": {
        "build": {
            "statusBarVisibility": "hidden"
        },
        "launch": {
            "statusBarVisibility": "hidden"
        },
        "debug": {
            "statusBarVisibility": "hidden"
        }
    },
    "cmake.configureOnEdit": true,
    "cmake.automaticReconfigure": true,
    "cmake.configureOnOpen": true,
    "cmake.buildBeforeRun": true,
    "cmake.generator": "Ninja",
    "cmake.cmakePath": "${userHome}/.pico-sdk/cmake/v3.31.5/bin/cmake",
    "C_Cpp.debugShortcut": false,
    "terminal.integrated.env.windows": {
        "PICO_SDK_PATH": "${env:USERPROFILE}/.pico-sdk/sdk/2.2.0",
        "PICO_TOOLCHAIN_PATH": "${env:USERPROFILE}/.pico-sdk/toolchain/14_2_Rel1",
        "Path": "${env:USERPROFILE}/.pico-sdk/toolchain/14_2_Rel1/bin;${env:USERPROFILE}/.pico-sdk/picotool/2.2.0-a4/picotool;${env:USERPROFILE}/.pico-sdk/cmake/v3.31.5/bin;${env:USERPROFILE}/.pico-sdk/ninja/v1.12.1;${env:PATH}"
    },
    "terminal.integrated.env.osx": {
        "PICO_SDK_PATH": "${env:HOME}/.pico-sdk/sdk/2.2.0",
        "PICO_TOOLCHAIN_PATH": "${env:HOME}/.pico-sdk/toolchain/14_2_Rel1",
        "PATH": "${env:HOME}/.pico-sdk/toolchain/14_2_Rel1/bin:${env:HOME}/.pico-sdk/picotool/2.2.0-a4/picotool:${env:HOME}/.pico-sdk/cmake/v3.31.5/bin:${env:HOME}/.pico-sdk/ninja/v1.12.1:${env:PATH}"
    },
    "terminal.integrated.env.linux": {
        "PICO_SDK_PATH": "${env:HOME}/.pico-sdk/sdk/2.2.0",
        "PICO_TOOLCHAIN_PATH": "${env:HOME}/.pico-sdk/toolchain/14_2_Rel1",
        "PATH": "${env:HOME}/.pico-sdk/toolchain/14_2_Rel1/bin:${env:HOME}/.pico-sdk/picotool/2.2.0-a4/picotool:${env:HOME}/.pico-sdk/cmake/v3.31.5/bin:${env:HOME}/.pico-sdk/ninja/v1.12.1:${env:PATH}"
    },
    // Let clangd query the real cross-compiler for its system include paths
    // (newlib/libstdc++). Pairs with the .clangd file at the project root,
    // which sets --target=arm-none-eabi and strips GCC-only flags.
    "clangd.arguments": [
        "--query-driver=C:/Users/Jared/.pico-sdk/toolchain/*/bin/arm-none-eabi-*"
    ],
    "raspberry-pi-pico.cmakeAutoConfigure": false,
    "raspberry-pi-pico.useCmakeTools": true,
    "raspberry-pi-pico.cmakePath": "${HOME}/.pico-sdk/cmake/v3.31.5/bin/cmake",
    "raspberry-pi-pico.ninjaPath": "${HOME}/.pico-sdk/ninja/v1.12.1/ninja"
}